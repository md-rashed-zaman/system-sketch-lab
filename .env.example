# Required: random 32+ byte secret for session signing (openssl rand -hex 32)
BETTER_AUTH_SECRET=
# Public URL of the app
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# SQLite file (defaults to ./data/system-sketch-lab.db)
DATABASE_PATH=
# Set to "off" only for automated tests (disables the sign-in/sign-up rate limit)
AUTH_RATE_LIMIT=
# "test" upgrades instantly through a fake checkout; "live" uses Lemon Squeezy
PAYMENTS_MODE=test
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_YEARLY=
LEMONSQUEEZY_VARIANT_LIFETIME=
